// Отправка алерта админом на доступ.
// В каждый момент на доступ — не больше одного active=true (инвариант держит сервис).
// История отправок; показывается человеку всегда только текущий активный.
model Alert {
    id        String   @id @default(uuid())
    message   String
    sender    String
    active    Boolean  @default(true)
    createdAt DateTime @default(now())

    // Снимок вида уведомления на момент отправки (тип доступа тогда). Нужен, чтобы
    // история рендерилась тем скином, каким РЕАЛЬНО показывали, даже если тип
    // доступа позже переключили. Старым записям миграция ставит IPHONE — до этого
    // всегда показывался iOS-вид.
    type ContinueTokenType @default(IPHONE)

    // Вид подачи (снимок на момент отправки). SMS — пуш-баннер (прежнее поведение),
    // ALERT — модалка-диалог с кнопкой. Старым записям миграция ставит SMS (их реальный вид).
    kind AlertKind @default(SMS)

    // Кастомная кнопка (только для kind=ALERT). buttonLabel=null → дефолтная «Понятно».
    // buttonUrl=null/пусто → кнопка просто закрывает алерт; иначе переход по ссылке (тот же таб).
    buttonLabel String?
    buttonUrl   String?

    tokenId String
    token   Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    views AlertView[]

    @@index([tokenId])
    @@index([active])
    @@map("alerts")
}
